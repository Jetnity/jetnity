  "required_findings": [
    {
      "id": "MA1-PLAN-SQL-R1",
      "severity": "P2",
      "kind": "Concrete rollback design/acceptance gap",
      "plan_lines": [
        240,
        242,
        276
      ],
      "problem": "The stated rollback algorithm specifies local/schema guards, ACCESS EXCLUSIVE locks, post-wait emptiness and finite RESTRICT drops, while promising refusal of unknown ACL grants and role memberships. RESTRICT does not itself preserve an unexpected membership when dropping its role, nor make an ACL grant on an object being dropped a protected external dependent object. Without explicit checks, the promised refusal can silently remove the unexpected grant/membership.",
      "repository_evidence": [
        {
          "path": "scripts/db/official-truth-v3-intake-store-1/native.ts",
          "lines": [
            58,
            350,
            354
          ],
          "observation": "S1 grants its caller role to ot_s1_test_runner, then successfully drops candidate roles while preserving the runner. That pattern cannot prove MA1 unknown-membership refusal."
        },
        {
          "path": "scripts/db/official-truth-v3-intake-store-1/intake-candidate.rollback.sql",
          "lines": [
            17,
            38,
            44,
            45
          ],
          "observation": "S1 finite RESTRICT object teardown and DROP ROLE are a dependency-removal pattern, not a complete ACL/membership inventory guard."
        }
      ],
      "required_fix": "Freeze a finite explicit post-table-lock, pre-DROP validation of the exact MA1 object/owner/ACL inventory and new-reader role attributes/memberships. Reject unknown ACL grants/grant options or memberships with no normalization/revoke/drop of the unexpected state. The native harness must explicitly remove only its known fixture reader membership before the successful rollback case; unknown membership/grants remain unchanged after refusal. Keep existing three-table post-wait empty guard and RESTRICT external-dependency protection.",
      "required_evidence": "Existing acceptance group12 must explicitly exercise unexpected membership and direct object/column ACL grant, then inspect preserved candidate objects, membership and grant on fresh observation. No new shared installer/helper/default changes.",
      "basis": "Source reasoning and actual repository pattern; no native execution.",
      "root_disposition": "Root independently accepted this finding for same-session CHANGES REQUIRED."
    }
  ],
  "wording_corrections": [
    {
      "id": "MA1-PLAN-SQL-W1",
      "plan_lines": [
        217,
        266
      ],
      "severity": "Required acceptance-wording correction, no new architecture",
      "problem": "The phrase poisoned creator function/table/schema/column default privileges treats column privileges as an ALTER DEFAULT PRIVILEGES object class. There is no column-default privilege form.",
      "fix": "Name supported function/table/schema default poisoning separately from explicit column ACL inspection/direct-grant negatives. Direct column grants can be included in the bounded rollback ACL-refusal fixture; do not invent an event-trigger or other mechanism merely to simulate nonexistent column defaults.",
      "root_disposition": "Root requested this exact finite wording correction."
    }
  ],
  "accepted_source_design_points_not_runtime_pass": [
