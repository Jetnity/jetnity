{
  "name": "jetnity",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:setup": "tsx check-jetnity-setup.ts",
    "check:setup:ci": "tsx check-jetnity-setup.ts --ci",
    "check:setup:fix": "tsx check-jetnity-setup.ts --fix --ci",
    "prebuild": "npm run check:setup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "next lint",
    "check:dead": "node scripts/erreichbarkeit.mjs",
    "check:exports": "node scripts/exporte.mjs",
    "check:deps": "node scripts/pakete.mjs",
    "check:api-schutz": "node scripts/api-schutz.mjs",
    "check:schema-bezug": "node scripts/db/verwendung.mjs --pruefen",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "db:inventar": "node scripts/db/inventory.mjs",
    "db:reproduzierbarkeit": "node scripts/db/reproduzierbarkeit.mjs",
    "db:anwenden": "node --import tsx scripts/db/anwenden.ts",
    "production:pruefen": "node --import tsx scripts/db/production-pruefen.ts",
    "db:verwendung": "node scripts/db/verwendung.mjs",
    "db:rls": "node scripts/db/rls.mjs",
    "db:rechte": "node scripts/db/rechte.mjs",
    "db:sicherheit": "node scripts/db/sicherheit.mjs",
    "db:parallelitaet": "node scripts/db/parallelitaet.mjs",
    "db:kontingent": "node --import tsx scripts/db/kontingent.ts",
    "db:typen": "node scripts/db/typen.mjs",
    "db:advisors": "node scripts/db/advisors.mjs",
    "modell:probe": "node --import tsx scripts/modell/probe.ts",
    "auth:pruefen": "node --import tsx scripts/auth/pruefen.ts",
    "auth:anwenden": "node --import tsx scripts/auth/anwenden.ts",
    "auth:fluesse": "node --import tsx scripts/auth/fluesse.ts",
    "auth:testkonto": "node --import tsx scripts/auth/testkonto.ts",
    "airports:importieren": "node --import tsx scripts/airports/importieren.ts",
    "places:importieren": "node --import tsx scripts/places/importieren.ts",
    "audit:activities": "node scripts/activities-ui-audit.mjs",
    "audit:trip-workspace": "node scripts/trip-workspace-ui-audit.mjs",
    "audit:account": "node scripts/account-ui-audit.mjs",
    "audit:admin-system-health": "node scripts/admin-system-health-ui-audit.mjs",
    "audit:admin-provider-ops": "node scripts/admin-provider-ops-ui-audit.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "14.2.32",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "recharts": "^3.1.2",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.0.7",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.12",
    "playwright": "^1.55.0",
    "postcss": "^8.5.6",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.3",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "simple-swizzle": "0.2.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
